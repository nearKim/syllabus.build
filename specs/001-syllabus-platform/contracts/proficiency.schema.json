{
  "$comment": "GENERATED FILE — DO NOT EDIT MANUALLY. Source of truth: specs/product.md",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syllabus.example.invalid/schemas/v0.2/proficiency.schema.json",
  "title": "Private proficiency projection — v0.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "profile_revision_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "account_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "computed_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "objective_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectiveEvidence"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "topic_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "assessed_objective_version_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "unassessed_objective_version_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "coverage_label": {
            "type": "string",
            "enum": [
              "unassessed",
              "partial",
              "covers_declared_objectives"
            ]
          }
        },
        "required": [
          "topic_id",
          "assessed_objective_version_ids",
          "unassessed_objective_version_ids",
          "coverage_label"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    }
  },
  "required": [
    "schema_version",
    "profile_revision_id",
    "account_id",
    "computed_at",
    "policy_version",
    "objective_evidence",
    "topic_coverage"
  ],
  "additionalProperties": false,
  "readOnly": true,
  "description": "Private server projection. Categorical support is a reviewed policy label, not a calibrated probability. Numeric item scores may exist on attempts but are not topic mastery estimates.",
  "$defs": {
    "objectiveEvidence": {
      "type": "object",
      "properties": {
        "objective_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "objective_version_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "topic_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "self_reported",
            "needs_practice",
            "demonstrated"
          ]
        },
        "evidence_support": {
          "type": "string",
          "enum": [
            "none",
            "limited",
            "corroborated"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "last_observed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 20,
              "maxLength": 40,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh_recommended": {
          "type": "boolean"
        },
        "criterion_policy_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "conditions_summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "objective_id",
        "objective_version_id",
        "topic_id",
        "status",
        "evidence_support",
        "evidence_refs",
        "last_observed_at",
        "refresh_recommended",
        "criterion_policy_id",
        "conditions_summary",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "self_reported"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_support": {
                "const": "none"
              },
              "evidence_refs": {
                "maxItems": 0
              },
              "last_observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "needs_practice",
                  "demonstrated"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "evidence_support": {
                "type": "string",
                "enum": [
                  "limited",
                  "corroborated"
                ]
              },
              "last_observed_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40,
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
