        "playback_speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "planning_horizon_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 730
        },
        "include_hands_on": {
          "type": "boolean"
        }
      },
      "required": [
        "include_optional_certification",
        "playback_speed",
        "planning_horizon_days",
        "include_hands_on"
      ],
      "additionalProperties": false
