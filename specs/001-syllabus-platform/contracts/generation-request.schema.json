            "model_policy_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "credential_version_ref": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "allow_hosted_fallback": {
              "const": false
            }
          },
          "required": [
            "mode",
            "provider_id",
            "credential_ref",
            "model_policy_id",
            "credential_version_ref",
            "allow_hosted_fallback"
          ],
          "additionalProperties": false
        }
      ]
