    "instruction_preferences": {
      "$ref": "#/$defs/instructionPreferences"
    },
    "template_origin": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "publication_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "publication_revision_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "expected_content_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "publication_id",
            "publication_revision_id",
            "expected_content_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "goal",
    "learner_profile",
    "constraints",
    "access_policy",
    "budgets",
    "inference",
    "generation_options",
    "instruction_preferences",
    "template_origin"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "access_policy": {
            "properties": {
              "mode": {
                "enum": [
                  "free_only",
                  "free_or_owned",
                  "owned_only"
                ]
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "access_policy"
        ]
      },
      "then": {
        "properties": {
          "budgets": {
            "properties": {
              "materials": {
                "properties": {
                  "max_minor_units": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "constraints": {
            "properties": {
              "deadline_policy": {
                "const": "no_deadline"
              }
            },
            "required": [
              "deadline_policy"
            ]
          }
        },
        "required": [
          "constraints"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "target_end_date": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "constraints": {
            "properties": {
              "target_end_date": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10,
                "format": "date"
              }
            }
          }
        }
      }
    }
  ],
