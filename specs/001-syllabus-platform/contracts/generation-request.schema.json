{
  "$comment": "GENERATED FILE — DO NOT EDIT MANUALLY. Source of truth: specs/product.md",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syllabus.example.invalid/schemas/v0.2/generation-request.schema.json",
  "title": "Syllabus generation request — draft contract v0.2",
  "description": "User intent and constraints. Account identity comes from authentication. Only opaque credential handles are accepted; arbitrary provider endpoints, raw API keys, caller-supplied resource facts and internal retrieval plans are not accepted.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "goal": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "desired_outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 20
        },
        "scope_mode": {
          "type": "string",
          "enum": [
            "focused",
            "broad_survey",
            "role_preparation",
            "certification_preparation"
          ]
        },
        "target_certification_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": [
        "prompt",
        "desired_outcomes",
        "scope_mode",
        "target_certification_ids"
      ],
      "additionalProperties": false
    },
    "learner_profile": {
      "type": "object",
      "properties": {
        "experience_level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced",
            "mixed",
            "unknown"
          ],
          "description": "Optional coarse self-description required as unknown when omitted in UI; never authoritative objective-level ability."
        },
        "background_summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 3000
        },
        "self_reported_known_objective_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "diagnostic_result_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "preferred_language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "accessibility_needs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "captions",
              "transcript",
              "keyboard_access",
              "screen_reader",
              "reduced_motion"
            ]
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "topic_self_reports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "claim": {
                "type": "string",
                "enum": [
                  "unfamiliar",
                  "some_experience",
                  "comfortable",
                  "advanced"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 0,
                "maxLength": 1000
              }
            },
            "required": [
              "topic_id",
              "claim",
              "notes"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "proficiency_snapshot_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "experience_level",
        "background_summary",
        "self_reported_known_objective_ids",
        "diagnostic_result_refs",
        "preferred_language",
        "accessibility_needs",
        "topic_self_reports",
        "proficiency_snapshot_ref"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "weekly_minutes": {
          "type": "integer",
          "minimum": 30,
          "maximum": 2400
        },
        "start_date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "format": "date"
        },
        "target_end_date": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_policy": {
          "type": "string",
          "enum": [
            "fixed",
            "flexible",
            "no_deadline"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "IANA timezone identifier. The application must validate it against its supported timezone database."
        },
        "available_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "start_local": {
                "type": "string",
                "minLength": 5,
                "maxLength": 5,
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end_local": {
                "type": "string",
                "minLength": 5,
                "maxLength": 5,
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "required": [
              "weekday",
              "start_local",
              "end_local"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 35
        },
        "max_session_minutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 240
        },
        "sequence_preference": {
          "type": "string",
          "enum": [
            "theory_first",
            "application_first",
            "balanced"
          ]
        },
        "guidance_preference": {
          "type": "string",
          "enum": [
            "adaptive",
            "guided",
            "independent"
          ]
        },
        "preferred_resource_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "course",
              "video",
              "book",
              "textbook",
              "repository",
              "project",
              "documentation",
              "article"
            ]
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "weekly_minutes",
        "start_date",
        "target_end_date",
        "deadline_policy",
        "timezone",
        "available_slots",
        "max_session_minutes",
        "sequence_preference",
        "guidance_preference",
        "preferred_resource_types"
      ],
      "additionalProperties": false
    },
    "access_policy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "free_only",
            "free_or_owned",
            "owned_only",
            "allow_paid"
          ]
        },
        "owned_resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 0,
          "maxItems": 300,
          "uniqueItems": true
        },
        "owned_subscription_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "unknown_price_policy": {
          "const": "exclude"
        },
        "allow_trial_required_resources": {
          "const": false
        },
        "region": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [
        "mode",
        "owned_resource_ids",
        "owned_subscription_ids",
        "unknown_price_policy",
        "allow_trial_required_resources",
        "region"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "materials": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$"
            },
            "max_minor_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "currency",
            "max_minor_units"
          ],
          "additionalProperties": false,
          "description": "Explicit spending authorization or planning cap; its scope is stated by the containing field."
        },
        "compute": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$"
            },
            "max_minor_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "currency",
            "max_minor_units"
          ],
          "additionalProperties": false,
          "description": "Explicit spending authorization or planning cap; its scope is stated by the containing field."
        },
        "inference": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$"
            },
            "max_minor_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "currency",
            "max_minor_units"
          ],
          "additionalProperties": false,
          "description": "Explicit spending authorization or planning cap; its scope is stated by the containing field."
        }
      },
      "required": [
        "materials",
        "compute",
        "inference"
      ],
      "additionalProperties": false,
      "description": "Materials and compute are whole-syllabus planning caps; inference is the per-generation authorization ceiling. Hosted inference caps platform charges; BYOK caps calls initiated by this app using estimated provider rates and cannot cap unrelated provider-account usage. Unknown mandatory costs do not satisfy a hard cap."
    },
    "inference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "hosted"
            },
            "model_policy_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            }
          },
          "required": [
            "mode",
            "model_policy_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "byok"
            },
            "provider_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
