{
  "$comment": "GENERATED FILE — DO NOT EDIT MANUALLY. Source of truth: specs/product.md",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curriculum.example.invalid/schemas/v0.2/public-curriculum.schema.json",
  "title": "Public curriculum snapshot — v0.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "publication_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "publication_revision_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "supersedes_publication_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher": {
      "type": "object",
      "properties": {
        "public_author_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "public_author_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "published_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "content": {
      "$ref": "#/$defs/publicContent"
    },
    "publication_terms": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "content_license_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "rights_scope": {
          "const": "eligible_original_annotations_and_structure"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "third_party_materials_excluded": {
          "const": true
        }
      },
      "required": [
        "policy_id",
        "content_license_id",
        "rights_scope",
        "attribution",
        "third_party_materials_excluded"
      ],
      "additionalProperties": false
    },
    "origin": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "publication_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "publication_revision_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "publication_id",
            "publication_revision_id",
            "attribution"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "publication_id",
    "publication_revision_id",
    "revision_number",
    "supersedes_publication_revision_id",
    "publisher",
    "published_at",
    "content_sha256",
    "content",
    "publication_terms",
    "origin"
  ],
  "additionalProperties": false,
  "description": "Immutable shareable projection. No account/proficiency/attempt/schedule/secret/private provenance fields. Lifecycle, rights overlays and votes live outside this content. Hash uses the declared canonicalization policy, not arbitrary JSON byte order.",
  "$defs": {
    "publicObjective": {
      "type": "object",
      "properties": {
        "objective_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "success_criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "level": {
          "type": "string",
          "enum": [
            "introductory",
            "applied",
            "advanced"
          ]
        },
        "requirement_level": {
          "type": "string",
          "enum": [
            "required",
            "optional"
          ]
        },
        "topic_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "objective_version_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        }
      },
      "required": [
        "objective_id",
        "title",
        "description",
        "success_criterion",
        "level",
        "requirement_level",
        "topic_id",
        "objective_version_id"
      ],
      "additionalProperties": false
    },
    "publicActivity": {
      "type": "object",
      "properties": {
        "activity_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "theory",
            "worked_example",
            "coding",
            "quiz",
            "review",
            "reflection",
            "project"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requirement_level": {
          "type": "string",
          "enum": [
            "required",
            "optional"
          ]
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "prerequisite_activity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 0,
          "maxItems": 50,
          "uniqueItems": true
        },
        "resource_assignments": {
          "type": "array",
          "items": {
            "$ref": "./curriculum.schema.json#/$defs/resourceAssignment"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "duration_estimate": {
          "$ref": "./curriculum.schema.json#/$defs/durationEstimate"
        },
        "public_instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "assessment_expectation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "objective_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                  },
                  "minItems": 1,
                  "maxItems": 30,
                  "uniqueItems": true
                },
                "assurance": {
                  "type": "string",
                  "enum": [
                    "reviewed_anchor_available",
                    "practice_only",
                    "coverage_gap"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "objective_ids",
                "assurance",
                "description"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "mastery_gated": {
          "type": "boolean",
          "description": "Whether this activity is marked mastery_gated in the template."
        }
      },
      "required": [
        "activity_id",
        "type",
        "title",
        "requirement_level",
        "objective_ids",
        "prerequisite_activity_ids",
        "resource_assignments",
        "duration_estimate",
        "public_instructions",
        "assessment_expectation"
      ],
      "additionalProperties": false
    },
    "publicContent": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "audience_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "topic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "sequence_preference": {
          "type": "string",
          "enum": [
            "theory_first",
            "application_first",
            "balanced"
          ]
        },
        "instruction_preferences": {
          "$ref": "./generation-request.schema.json#/$defs/instructionPreferences"
        },
        "prerequisite_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objective_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "objective_version_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "topic_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "expectation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1500
              }
            },
            "required": [
              "objective_id",
              "objective_version_id",
              "topic_id",
              "expectation"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 200
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicObjective"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "prerequisite_edges": {
          "type": "array",
          "items": {
            "$ref": "./curriculum.schema.json#/$defs/prerequisiteEdge"
          },
          "minItems": 0,
          "maxItems": 800
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "./curriculum.schema.json#/$defs/module"
          },
          "minItems": 1,
          "maxItems": 60
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicActivity"
          },
          "minItems": 1,
          "maxItems": 600
        },
        "certification_options": {
          "type": "array",
          "items": {
            "$ref": "./curriculum.schema.json#/$defs/certificationOption"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "coverage_limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objective_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "missing_requirement": {
                "type": "string",
                "enum": [
                  "instruction",
                  "practice",
                  "assessment",
                  "source_coverage"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "objective_id",
              "missing_requirement",
              "explanation"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 200
        },
        "effort": {
          "type": "object",
          "properties": {
            "estimated_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "range_minutes": {
              "type": "object",
              "properties": {
                "lower": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "upper": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "lower",
                "upper"
              ],
              "additionalProperties": false
            },
            "playback_speed": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 3
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "estimated_minutes",
            "range_minutes",
            "playback_speed",
            "assumptions"
          ],
          "additionalProperties": false
        },
        "resource_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "minItems": 1,
          "maxItems": 400,
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "summary",
        "audience_summary",
        "language",
        "topic_ids",
        "sequence_preference",
        "instruction_preferences",
        "prerequisite_requirements",
        "objectives",
        "prerequisite_edges",
        "modules",
        "activities",
        "certification_options",
        "coverage_limitations",
        "effort",
        "resource_version_ids"
      ],
      "additionalProperties": false
    }
  }
}
