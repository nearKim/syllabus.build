# Syllabus.io Local Development Environment
APP_ENV=development
WEB_HOST=localhost
WEB_PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8080
API_BIND_ADDR=127.0.0.1:8080

# PostgreSQL 16 (docker compose up -d)
POSTGRES_USER=syllabus
POSTGRES_PASSWORD=syllabus
POSTGRES_DB=syllabus_dev
DATABASE_URL=postgres://syllabus:syllabus@127.0.0.1:5432/syllabus_dev

# OAuth 2.0 Providers (Authorization Code + PKCE S256)
# Leave client IDs empty in local development to use the built-in Local Dev OAuth Consent Sandbox,
# or paste credentials from Google Cloud Console / GitHub Developer Settings for live OAuth:
#   Google Authorized redirect URI: http://localhost:3000/auth/oauth/google/callback
#   GitHub Authorization callback URL: http://localhost:3000/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_COOKIE_SECRET=syllabus-local-dev-oauth-cookie-secret-change-in-prod

# Optional Server-Side AI Provider Keys for Live E2E Generation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
