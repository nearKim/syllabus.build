# Local Individual Development Environment Configuration (OPS-006 / CTRL-001)
# Copy to .env for local development. Never commit real credentials or .env files.

APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/curriculum_dev
API_BIND_ADDR=127.0.0.1:8080

# Development-only fixed identity (disabled automatically when APP_ENV != development/test)
DEV_FIXED_ACCOUNT_ID=00000000-0000-4000-8000-000000000001

# Deferred Release Decision Gates (Must remain false until owner approval):
# D11: Production authentication vendor & KMS custody approved
FEATURE_PRODUCTION_AUTH_APPROVED=false
# D07: Commercial pricing, payment/tax vendor & refund terms approved
FEATURE_LIVE_BILLING_ENABLED=false
# D16: Final public-curriculum content license & retention windows approved
FEATURE_PUBLIC_SHARING_ENABLED=false
# D15: Final operative custom personal-use license & CLA approved
FEATURE_OPERATIVE_LICENSE_APPROVED=false
