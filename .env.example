# ==============================================================================
# Syllabus.build Environment Configuration
# Copy to `.env` for local development or inject in your container orchestrator.
# ==============================================================================

# Runtime Environment (`development`, `test`, `staging`, `production`)
APP_ENV=development

# PostgreSQL 16 Connection
POSTGRES_USER=syllabus
POSTGRES_PASSWORD=syllabus
POSTGRES_DB=syllabus_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://syllabus:syllabus@127.0.0.1:5432/syllabus_dev

# Rust API Server (`syllabus-api`)
API_BIND_ADDR=127.0.0.1:8080
API_BASE_URL=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Interactive Web Server (`@syllabus/web`)
WEB_HOST=localhost
WEB_PORT=3000
PUBLIC_WEB_ORIGIN=http://localhost:3000
WEB_MAX_ACTIVE_SESSIONS=500
WEB_SESSION_IDLE_TTL_MS=86400000
WEB_RATE_LIMIT_MAX=300
WEB_RATE_LIMIT_WINDOW_MS=60000

# AES-256-GCM BYOK Envelope Master Key (32 bytes as 64 hex chars or base64)
# Generate via: openssl rand -hex 32
BYOK_MASTER_KEY=

# Signed OAuth PKCE State Cookie Secret (32+ bytes hex)
# Generate via: openssl rand -hex 32
OAUTH_COOKIE_SECRET=

# Optional OAuth 2.0 Identity Providers (PKCE S256)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Server-Side Hosted Inference Keys (Leave empty for pure BYOK mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Hosted Wallet & Billing Webhooks
STRIPE_SECRET_KEY=
BILLING_WEBHOOK_SECRET=whsec_syllabus_io_dev_secret_key_2026

# Background Outbox Worker (`syllabus-worker`) & Notification Transports
WORKER_ID=worker-main
WORKER_POLL_MS=2000
RESEND_API_KEY=
EMAIL_FROM=noreply@syllabus.build
EMAIL_WEBHOOK_URL=

# Release Feature Gates (`true`/`false`, override per environment if needed)
FEATURE_GATE_HOSTED_INFERENCE=true
FEATURE_GATE_WALLET_CHECKOUT=true
FEATURE_GATE_COMMUNITY_MARKETPLACE=true
FEATURE_GATE_PASSKEY_AUTH=true
FEATURE_GATE_PUSH_REMINDERS=true
